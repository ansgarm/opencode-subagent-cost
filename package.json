    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.9.2"
  },
  "license": "MIT"
}

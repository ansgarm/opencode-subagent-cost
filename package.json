{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-subagent-cost",
  "version": "0.1.0",
  "description": "Show OpenCode session cost including all subagents.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansgarm/opencode-subagent-cost.git"
  },
  "bugs": {
    "url": "https://github.com/ansgarm/opencode-subagent-cost/issues"
  },
  "homepage": "https://github.com/ansgarm/opencode-subagent-cost#readme",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && bun test",
    "prepack": "bun run build"
  },
  "engines": {
    "opencode": ">=1.18.31"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.31",
